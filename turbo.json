{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["TZ"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tsdown.config.ts",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "index.html"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "../../tsconfig.base.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    "//#lint:api": {
      "inputs": [
        "scripts/check-api.mjs",
        "packages/*/src/**",
        "packages/*/package.json"
      ],
      "outputs": []
    },

    "//#lint:treeshake": {
      "inputs": [
        "scripts/check-treeshake.mjs",
        "packages/*/src/**",
        "packages/*/package.json"
      ],
      "outputs": []
    }
  }
}
