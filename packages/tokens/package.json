{
  "name": "@shiftcharts/tokens",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "ShiftCharts CSS custom-property themes and generated TypeScript token types.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeshpandeBoy/Defence-Charts.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/DeshpandeBoy/Defence-Charts",
  "bugs": {
    "url": "https://github.com/DeshpandeBoy/Defence-Charts/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./theme.css": "./src/themes/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/emit-package-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./theme.css": "./dist/themes/theme.css"
    }
  }
}
