{
  "name": "gx-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Responsive, size-adaptive chart + dashboard-grid widget library. Research and design in research/.",
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22 || ^24 || >=26",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:docs": "pnpm --filter @gx/docs lint",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:granularity": "node scripts/check-granularity.mjs",
    "lint:policy": "node scripts/check-policy-thresholds.mjs",
    "lint:determinism": "node scripts/check-determinism.mjs",
    "lint:api": "node scripts/check-api.mjs",
    "lint:treeshake": "node scripts/check-treeshake.mjs",
    "lint:boundary": "node scripts/check-boundary.mjs",
    "lint:containment": "node scripts/check-containment.mjs",
    "lint:grid": "node scripts/check-grid-browser.mjs",
    "lint:rsc": "node scripts/check-rsc.mjs",
    "lint:motion": "node scripts/check-motion.mjs",
    "probe:motion": "node scripts/probe-motion.mjs",
    "probe:flicker": "node scripts/probe-flicker.mjs",
    "lint:typography": "node scripts/generate-typography-css.mjs",
    "lint:tokens:drift": "node scripts/generate-tokens-css.mjs",
    "generate:typography": "pnpm --filter @gx/core build && node scripts/generate-typography-css.mjs --write",
    "generate:tokens": "node scripts/generate-tokens-css.mjs --write",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:docs && pnpm lint:deps && pnpm lint:tokens && pnpm lint:granularity && pnpm lint:policy && pnpm lint:determinism && pnpm lint:api && pnpm lint:treeshake && pnpm test && pnpm build && pnpm lint:boundary && pnpm lint:typography && pnpm lint:tokens:drift"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "rolldown": "1.2.5",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
