{
  "name": "@gx/grid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "12-column widget grid shell. Reports box size to a widget; never decides what the widget shows.",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./widget-shell.css": "./src/widget-shell.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gx/core": "workspace:*",
    "@gx/react": "workspace:*",
    "react-grid-layout": "2.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
