{
  "name": "@gx/grid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "12-column widget grid shell. Reports box size to a widget; never decides what the widget shows.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./widget-shell.css": "./src/widget-shell.css",
    "./widget-states.css": "./src/widget-states.css",
    "./keyboard-grid.css": "./src/keyboard-grid.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/emit-package-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gx/core": "workspace:*",
    "@gx/react": "workspace:*",
    "react-grid-layout": "2.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./widget-shell.css": "./dist/widget-shell.css",
      "./widget-states.css": "./dist/widget-states.css",
      "./keyboard-grid.css": "./dist/keyboard-grid.css"
    }
  }
}
