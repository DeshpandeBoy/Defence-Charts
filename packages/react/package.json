{
  "name": "@shiftcharts/react",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Adaptive ShiftCharts client boundary with measurement, tooltip, crosshair, and controlled legends.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeshpandeBoy/Defence-Charts.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/DeshpandeBoy/Defence-Charts",
  "bugs": {
    "url": "https://github.com/DeshpandeBoy/Defence-Charts/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./auto-chart.css": "./src/auto-chart.css",
    "./interaction-overlay.css": "./src/interaction-overlay.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/emit-package-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shiftcharts/core": "workspace:*",
    "@shiftcharts/primitives": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@shiftcharts/testing": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./auto-chart.css": "./dist/auto-chart.css",
      "./interaction-overlay.css": "./dist/interaction-overlay.css"
    }
  }
}
