{
  "name": "@gx/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The client boundary. <AutoChart>, useElementSize, tooltip, crosshair, brush, legend interaction.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./auto-chart.css": "./src/auto-chart.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/emit-package-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gx/core": "workspace:*",
    "@gx/primitives": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@gx/testing": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./auto-chart.css": "./dist/auto-chart.css"
    }
  }
}
