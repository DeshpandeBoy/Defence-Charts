{
  "name": "@shiftcharts/grid",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "ShiftCharts 12-column widget grid, shell, keyboard controls, and stable layout adapters.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeshpandeBoy/Defence-Charts.git",
    "directory": "packages/grid"
  },
  "homepage": "https://github.com/DeshpandeBoy/Defence-Charts",
  "bugs": {
    "url": "https://github.com/DeshpandeBoy/Defence-Charts/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./widget-shell.css": "./src/widget-shell.css",
    "./widget-states.css": "./src/widget-states.css",
    "./keyboard-grid.css": "./src/keyboard-grid.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node ../../scripts/emit-package-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shiftcharts/core": "workspace:*",
    "react-grid-layout": "2.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./widget-shell.css": "./dist/widget-shell.css",
      "./widget-states.css": "./dist/widget-states.css",
      "./keyboard-grid.css": "./dist/keyboard-grid.css"
    }
  }
}
